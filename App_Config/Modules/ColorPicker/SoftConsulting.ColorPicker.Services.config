<?xml version="1.0" encoding="utf-8"?>
<!--
  Registers this module's services with Sitecore's dependency injection container (see
  SoftConsulting.ColorPicker.Infrastructure.ColorPickerServicesConfigurator) - needed for the
  classes that are resolved through that container rather than constructor-injected (see the
  class for which ones and why).

  This module's Sitecore items (the "Color Picker" field type, the Palette template, the
  swatch validator, the sample palettes) are no longer provisioned by an initialize-pipeline
  processor - they're pushed from serialization/ColorPicker/ColorPicker.module.json via the
  Sitecore CLI (see the README's "Deploying" section), so there is no <pipelines> section here
  any more.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <services>
      <configurator type="SoftConsulting.ColorPicker.Infrastructure.ColorPickerServicesConfigurator, SoftConsulting.ColorPicker" />
    </services>
  </sitecore>
</configuration>
