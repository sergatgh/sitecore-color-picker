<?xml version="1.0" encoding="utf-8"?>
<!--
  Wires the idempotent, self-healing bootstrap that provisions the "Color Picker" field type
  item in the core database on every application start. This is the supported, permanent
  mechanism for deploying this module - no serialized items / SCS push step is required.

  Also registers this module's services with Sitecore's dependency injection container (see
  SoftConsulting.ColorPicker.Infrastructure.ColorPickerServicesConfigurator), for the classes
  that are resolved through that container (see the class for which ones and why).

  InitializeSwatchValidator and InitializeColorPickerPalette are not built through the DI
  container - Sitecore still creates them via the default reflection-based processor
  instantiation, but each nested typed &lt;param&gt; below is itself constructed by Sitecore's
  Factory and passed straight into the processor's constructor, so IContentDatabaseResolver is
  still supplied from this same XML rather than a hardcoded "new" inside the processor.
  InitializeColorPickerFieldType needs no such dependency, so it has no &lt;param&gt;.

  Each &lt;param&gt; carries a desc="..." attribute matching the constructor parameter's name, so
  consumers of this library can override just that one argument from their own patch config,
  without touching the other &lt;param&gt; siblings, e.g. to supply a custom
  IContentDatabaseResolver implementation:

    <processor patch:instead="processor[@type='SoftConsulting.ColorPicker.Processors.InitializeColorPickerPalette, SoftConsulting.ColorPicker']"
               type="SoftConsulting.ColorPicker.Processors.InitializeColorPickerPalette, SoftConsulting.ColorPicker">
      <param desc="contentDatabaseResolver" type="My.Company.CustomContentDatabaseResolver, My.Company" />
    </processor>
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <services>
      <configurator type="SoftConsulting.ColorPicker.Infrastructure.ColorPickerServicesConfigurator, SoftConsulting.ColorPicker" />
    </services>
    <pipelines>
      <initialize>
        <processor type="SoftConsulting.ColorPicker.Processors.InitializeColorPickerFieldType, SoftConsulting.ColorPicker" />
        <processor type="SoftConsulting.ColorPicker.Processors.InitializeSwatchValidator, SoftConsulting.ColorPicker">
          <param desc="contentDatabaseResolver" type="SoftConsulting.ColorPicker.Infrastructure.ContentDatabaseResolver, SoftConsulting.ColorPicker" />
        </processor>
        <processor type="SoftConsulting.ColorPicker.Processors.InitializeColorPickerPalette, SoftConsulting.ColorPicker">
          <param desc="contentDatabaseResolver" type="SoftConsulting.ColorPicker.Infrastructure.ContentDatabaseResolver, SoftConsulting.ColorPicker" />
        </processor>
      </initialize>
    </pipelines>
  </sitecore>
</configuration>
