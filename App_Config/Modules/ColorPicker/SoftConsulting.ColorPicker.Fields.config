<?xml version="1.0" encoding="utf-8"?>
<!--
  Registers the namespace+prefix so Sitecore's Sheer/XML control resolver can map the
  "custom:ColorPicker" tag (the value of the Control field on /sitecore/system/Field
  types/Color Picker/Color Picker, core db) to SoftConsulting.ColorPicker.Fields.ColorPicker.
  Without the explicit prefix, the tag must match the bare class name exactly and resolution is
  unreliable - the Content Editor would otherwise silently fail to instantiate the field
  control even though the field type item resolves correctly in the "Type" dropdown.

  Also registers the field type with the data-API field wrapper registry (<fieldTypes>), the
  same mechanism used for built-in types like "Single-Line Text" -> Sitecore.Data.Fields.TextField.
  The name below ("Color Picker") is the field type item's own Sitecore item name (the leaf item
  under the "/sitecore/system/Field types/Color Picker" category folder) - that's what ends up in
  the "Type" dropdown and stored on a template field. It happens to match the folder's name. The
  Experience Editor also resolves the field's chrome toolbar buttons through this registration
  (CustomField.GetWebEditButtons reads the field type item's "WebEdit Buttons" children).

  Experience Editor support:
  - The renderField processor HTML-encodes the value and makes the field read-only text in the
    Experience Editor (no contenteditable). It must run before RenderWebEditing, which wraps the
    field for editing and reads the flag this processor sets.
  - The two commands back the field's "Edit color" (opens the color picker dialog,
    sitecore modules/Shell/ColorPicker/ColorPickerDialog.xml) and "Clear color" toolbar buttons.
    The buttons themselves are core items under
    /sitecore/system/Field types/Color Picker/Color Picker/WebEdit Buttons.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <controlSources>
      <source mode="on"
              namespace="SoftConsulting.ColorPicker.Fields"
              assembly="SoftConsulting.ColorPicker"
              prefix="custom" />
    </controlSources>
    <fieldTypes>
      <fieldType name="Color Picker"
                 type="SoftConsulting.ColorPicker.Fields.ColorPickerField, SoftConsulting.ColorPicker" />
    </fieldTypes>
    <commands>
      <command name="colorpicker:edit" type="SoftConsulting.ColorPicker.Commands.EditColor, SoftConsulting.ColorPicker" />
      <command name="colorpicker:clear" type="SoftConsulting.ColorPicker.Commands.ClearColor, SoftConsulting.ColorPicker" />
    </commands>
    <pipelines>
      <renderField>
        <processor type="SoftConsulting.ColorPicker.Pipelines.RenderField.RenderColorPickerField, SoftConsulting.ColorPicker"
                   patch:before="processor[@type='Sitecore.Pipelines.RenderField.RenderWebEditing, Sitecore.Kernel']" />
      </renderField>
    </pipelines>
  </sitecore>
</configuration>
