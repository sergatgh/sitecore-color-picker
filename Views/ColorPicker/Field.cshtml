@model SoftConsulting.ColorPicker.Fields.ColorPickerViewModel
@*
    Handlers are inlined on each element because the Content Editor injects this markup via
    innerHTML, which never executes <script> tags - do not add one. The hidden input is never
    disabled: disabled inputs are dropped from the form post.
*@
@functions
{
    // Combines the RGB and alpha expressions into the final value, writes it to every input,
    // repaints the preview and marks the Content Editor form as modified.
    private static string BuildSyncScript(string id, string hexExpression, string alphaExpression)
    {
        return string.Format(
            "var cp_h=document.getElementById('{0}');" +
            "var cp_n=document.getElementById('{0}_native');" +
            "var cp_x=document.getElementById('{0}_hex');" +
            "var cp_al=document.getElementById('{0}_alpha');" +
            "var cp_pv=document.getElementById('{0}_preview');" +
            "var cp_rgb=({1}).toUpperCase();" +
            "var cp_a=Math.max(0,Math.min(255,Math.round({2})));" +
            "var cp_ah=('0'+cp_a.toString(16).toUpperCase()).slice(-2);" +
            "var cp_v=(cp_a<255)?(cp_rgb+cp_ah):cp_rgb;" +
            "if(cp_h){{cp_h.value=cp_v;}}" +
            "if(cp_n){{cp_n.value=cp_rgb;}}" +
            "if(cp_x){{cp_x.value=cp_v;}}" +
            "if(cp_al){{cp_al.value=cp_a;}}" +
            "if(cp_pv){{cp_pv.style.backgroundImage=" + BackgroundImageJsExpression("cp_v") + ";}}" +
            "if(cp_h){{var ev;try{{ev=new Event('change',{{bubbles:true}});}}catch(e){{ev=document.createEvent('Event');ev.initEvent('change',true,true);}}cp_h.dispatchEvent(ev);}}" +
            "if(typeof scForm!=='undefined'&&scForm&&('modified' in scForm)){{scForm.modified=true;}}",
            id, hexExpression, alphaExpression);
    }

    private static string BuildHexChangeScript(string id, bool allowTransparency)
    {
        // With transparency off, only 6 digits are accepted so a pasted alpha can't sneak in.
        var pattern = allowTransparency
            ? "/^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$/"
            : "/^#[0-9A-Fa-f]{6}$/";
        var alphaExpression = allowTransparency ? "(v.length>=9?parseInt(v.substr(7,2),16):255)" : "255";

        return
            "var v=this.value;" +
            "if(v&&v.charAt(0)!=='#'){v='#'+v;}" +
            "if(" + pattern + ".test(v)){" +
                BuildSyncScript(id, "v.substr(0,7)", alphaExpression) +
            "}else{this.value=document.getElementById('" + id + "').value;}";
    }

    private static string BuildNativeChangeScript(string id, bool allowTransparency)
    {
        // The native input has no alpha, so keep the stored one instead of resetting to opaque.
        var alphaExpression = allowTransparency
            ? "(cp_h&&cp_h.value&&cp_h.value.length>=9?parseInt(cp_h.value.substr(7,2),16):255)"
            : "255";
        return BuildSyncScript(id, "this.value", alphaExpression);
    }

    private static string BuildAlphaInputScript(string id)
    {
        return BuildSyncScript(id, "(cp_h&&cp_h.value?cp_h.value.substr(0,7):'#000000')", "this.value");
    }

    // The color as a flat layer over a checkerboard, so translucency is visible.
    // Keep in sync with BuildSwatchBackgroundStyle.
    private static string BackgroundImageJsExpression(string colorJsExpression)
    {
        return "'linear-gradient('+" + colorJsExpression + "+','+" + colorJsExpression + "+')," +
               "linear-gradient(45deg,#ccc 25%,transparent 25%,transparent 75%,#ccc 75%)," +
               "linear-gradient(45deg,#ccc 25%,transparent 25%,transparent 75%,#ccc 75%)'";
    }

    private static string BuildSwatchBackgroundStyle(string hex)
    {
        return string.Format(
            "background-image:linear-gradient({0},{0})," +
            "linear-gradient(45deg,#ccc 25%,transparent 25%,transparent 75%,#ccc 75%)," +
            "linear-gradient(45deg,#ccc 25%,transparent 25%,transparent 75%,#ccc 75%);" +
            "background-size:auto,8px 8px,8px 8px;background-position:0 0,0 0,4px 4px;",
            hex);
    }

    private static string GetRgbPortion(string hex) 
    {
        return string.IsNullOrEmpty(hex) ? "#000000" : hex.Substring(0, 7);
    }

    private static int GetAlpha(string hex) 
    { 
        return !string.IsNullOrEmpty(hex) && hex.Length >= 9 ? System.Convert.ToInt32(hex.Substring(7, 2), 16) : 255;
    }
}
@{
    var disabledAttr = Model.ReadOnly ? "disabled" : null;
    var cursorStyle = Model.ReadOnly ? "cursor:not-allowed;opacity:0.6;" : "cursor:pointer;";
}
<div id="@(Model.Id)_wrapper" class="@(Model.ReadOnly ? "scColorPickerField scColorPickerReadOnly" : "scColorPickerField")" style="display:flex;flex-wrap:wrap;align-items:center;gap:6px;max-width:100%;box-sizing:border-box;">
    <input type="hidden" id="@Model.Id" name="@Model.Id" value="@Model.Value" />
    @if (Model.Swatches.Count == 0 && !Model.AllowCustomColor)
    {
        <span class="scColorPickerMessage" style="color:#b00020;">
            No colors are available: this field's Source disables custom color picking
            ("CustomColor=false") and defines no palette swatches. Add a Palette to the Source
            or enable custom color picking.
        </span>
    }
    else
    {
        if (Model.Swatches.Count > 0)
        {
            <span class="scColorPickerSwatches" style="display:inline-flex;flex-wrap:wrap;gap:4px;max-width:100%;">
                @foreach (var swatch in Model.Swatches)
                {
                    // A <button>, not an <a>: Content Editor CSS hides styled anchors.
                    var cssClass = swatch.Selected ? "scColorPickerSwatch scColorPickerSwatchSelected" : "scColorPickerSwatch";
                    var borderStyle = swatch.Selected ? "2px solid #1e88e5" : "1px solid #b9c0c7";
                    var swatchRgb = GetRgbPortion(swatch.Hex);
                    var swatchAlpha = Model.AllowTransparency ? GetAlpha(swatch.Hex).ToString() : "255";

                    // With transparency off, "#RRGGBBAA" swatches are drawn opaque.
                    var swatchDisplayHex = Model.AllowTransparency ? swatch.Hex : swatchRgb;
                    <button type="button" class="@cssClass" title="@(swatch.Name) (@swatchDisplayHex)"
                            style="display:inline-block;width:22px;height:22px;padding:0;@(BuildSwatchBackgroundStyle(swatchDisplayHex));border:@borderStyle;@cursorStyle"
                            disabled="@disabledAttr"
                            onclick="@Html.Raw(BuildSyncScript(Model.Id, "'" + swatchRgb + "'", swatchAlpha))"></button>
                }
            </span>
        }
        if (Model.AllowCustomColor)
        {
            <input type="color" id="@(Model.Id)_native" value="@Model.NativeValue"
                   title="Choose a color"
                   style="width:36px;height:28px;padding:0;border:1px solid #b9c0c7;@cursorStyle"
                   disabled="@disabledAttr"
                   onchange="@Html.Raw(BuildNativeChangeScript(Model.Id, Model.AllowTransparency))" />
            <input type="text" id="@(Model.Id)_hex" class="scColorPickerHex" maxlength="@(Model.AllowTransparency ? 9 : 7)"
                   value="@(Model.AllowTransparency ? Model.Value : GetRgbPortion(Model.Value))"
                   placeholder="@(Model.AllowTransparency ? "#RRGGBB[AA]" : "#RRGGBB")" style="width:96px;"
                   readonly="@(Model.ReadOnly ? "readonly" : null)"
                   onchange="@Html.Raw(BuildHexChangeScript(Model.Id, Model.AllowTransparency))" />
        }
        else
        {
            <input type="text" id="@(Model.Id)_hex" class="scColorPickerHex" readonly="readonly"
                   value="@(Model.AllowTransparency ? Model.Value : GetRgbPortion(Model.Value))"
                   title="Pick a color from the palette" style="width:96px;" />
        }
        if (Model.AllowTransparency)
        {
            <input type="range" id="@(Model.Id)_alpha" class="scColorPickerAlpha" min="0" max="255" step="1"
                   value="@GetAlpha(Model.Value)" title="Adjust transparency"
                   style="width:70px;@(Model.ReadOnly ? "cursor:not-allowed;opacity:0.6;" : null)"
                   disabled="@disabledAttr"
                   oninput="@Html.Raw(BuildAlphaInputScript(Model.Id))" />

            var previewValue = string.IsNullOrEmpty(Model.Value) ? "#00000000" : Model.Value;
            <span id="@(Model.Id)_preview" class="scColorPickerPreview" title="Preview"
                  style="display:inline-block;width:22px;height:22px;border:1px solid #b9c0c7;@(BuildSwatchBackgroundStyle(previewValue))"></span>
        }
    }
</div>
