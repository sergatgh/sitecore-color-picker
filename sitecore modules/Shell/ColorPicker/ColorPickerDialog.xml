<?xml version="1.0" encoding="utf-8" ?>
<!--
  The Experience Editor's color picker dialog, opened by the Color Picker field's "Edit color"
  chrome button (SoftConsulting.ColorPicker.Commands.EditColor) as
  /sitecore/shell/default.aspx?xmlcontrol=SoftConsulting.ColorPicker.Dialog. Sitecore finds this
  file because the default <controlSources> config scans "/sitecore modules" for XML controls.

  FormDialog supplies the standard dialog chrome (header, OK/Cancel). The picker markup is
  rendered into PickerHost from Views/ColorPicker/Dialog.cshtml by the code-beside, and
  ColorPickerDialog.js keeps the picked color in the hidden ColorValue input, which the
  code-beside reads back when OK is pressed.
-->
<control xmlns:def="Definition" xmlns="http://schemas.sitecore.net/Visual-Studio-Intellisense">
  <SoftConsulting.ColorPicker.Dialog>
    <Stylesheet Src="/sitecore%20modules/Shell/ColorPicker/ColorPickerDialog.css"></Stylesheet>
    <Script Src="/sitecore%20modules/Shell/ColorPicker/ColorPickerDialog.js"></Script>
    <FormDialog Icon="SoftwareV2/32x32/color_wheel.png" Header="Pick a color"
      Text="Choose a color on the spectrum, enter exact values, or pick one from the palette."
      OKButton="OK">
      <CodeBeside Type="SoftConsulting.ColorPicker.Dialogs.ColorPickerDialogForm, SoftConsulting.ColorPicker"/>

      <Edit ID="ColorValue" Style="display:none" />
      <Border ID="PickerHost" Class="cp-host" />
    </FormDialog>
  </SoftConsulting.ColorPicker.Dialog>
</control>
